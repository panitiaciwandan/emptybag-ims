{
  "name": "emptybag-ims",
  "version": "1.0.0",
  "private": true,
  "description": "Empty Bag Inventory Management System (EmptyBag-IMS) - PWA + Supabase PostgreSQL",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "db:migrate": "node scripts/db.js migrate",
    "db:seed": "node scripts/db.js seed",
    "db:test": "node scripts/db.js test",
    "db:reset": "node scripts/db.js reset",
    "db:setup": "node scripts/db.js setup",
    "test:db": "npm run db:test"
  },
  "engines": {
    "node": ">=18"
  }
}
