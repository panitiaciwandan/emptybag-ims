# ==============================================================================
# EmptyBag-IMS Environment Variables
# Copy this file to `.env` in the frontend directory and fill in real values.
# NEVER commit real secrets.
# ==============================================================================

# --- Supabase ---
# Project URL: https://app.supabase.com/project/<ref>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never exposed to the client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ---
VITE_APP_NAME=EmptyBag-IMS
VITE_APP_ENV=development

# --- Optional: local database for development/testing ---
# Used by scripts/db.js when running against a local PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emptybag_ims
